VITE_APP_BASE_URL="/"
# 后端 API 前缀，使用同域相对路径，由 nginx 按环境转发：
#   location ^~ /admin-api/ { proxy_pass http://ingress_pool; }
# 后端（lakego-admin）路由前缀本身就是 /admin-api，故此处填 /admin-api
VITE_APP_API_URL="/admin-api"
VITE_APP_TITLE_SUFFIX ="管理系统"
# cookie 域：留空 = 按当前站点 host 存储，各环境天然隔离。
# 本项目 token 只存 cookie，写死成生产域名会让 uat 域名拒写 cookie → 登录失效。
# cookie 域已改由后端 /admin-api/runtime-config.js 下发（见 src/utils/runtime-config.ts），
# 这里只作兜底；留空 = 按当前 host 存储（host-only）。
VITE_COOKIE_DOMAIN=""
# 跨系统跳转链接（资产系统 / 维修系统），按部署环境配置，避免 uat 跳到生产
VITE_ASSET_APP_URL="https://asset-uat.ecohash-inc.com/"
VITE_MAINTENANCE_APP_URL="https://maintenance-uat.ecohash-inc.com/"
