VITE_APP_BASE_URL="/"
# 后端 API 前缀，与生产保持一致（同域相对路径 /admin-api）；
# 本地开发由 vite dev server 的 proxy 转发到下面的 VITE_DEV_PROXY_TARGET
VITE_APP_API_URL="/admin-api"
# 仅本地开发使用的后端地址（vite dev proxy 目标），不会进入构建产物
VITE_DEV_PROXY_TARGET="http://localhost:8080"
VITE_APP_TITLE_SUFFIX ="管理系统"
# VITE_COOKIE_DOMAIN=".test.com"
VITE_COOKIE_DOMAIN=""
# 跨系统跳转链接（本地开发无对应站点，暂指向生产）
VITE_ASSET_APP_URL="https://asset.datastring.cc/"
VITE_MAINTENANCE_APP_URL="https://repair.datastring.cc/"
